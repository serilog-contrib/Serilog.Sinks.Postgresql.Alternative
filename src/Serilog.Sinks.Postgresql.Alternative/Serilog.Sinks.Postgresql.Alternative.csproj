<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <AssemblyName>Serilog.Sinks.Postgresql.Alternative</AssemblyName>
        <RootNamespace>Serilog</RootNamespace>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <PackageId>Serilog.Sinks.Postgresql.Alternative</PackageId>
        <Authors>SeppPenner and the Serilog contributors</Authors>
        <Company>SeppPenner and the Serilog contributors</Company>
        <Copyright>Copyright © SeppPenner and the Serilog contributors</Copyright>
        <Description>Serilog.Sinks.Postgresql.Alternative is a library to save logging information from https://github.com/serilog/serilog to https://www.postgresql.org/.</Description>
        <PackageTags>c# csharp serilog postgresql postgres sink logging log</PackageTags>
        <PackageProjectUrl>https://www.nuget.org/packages/Serilog.Sinks.Postgresql.Alternative/</PackageProjectUrl>
        <RepositoryUrl>https://github.com/serilog-contrib/Serilog.Sinks.Postgresql.Alternative</RepositoryUrl>
        <PackageIcon>Icon.png</PackageIcon>
        <RepositoryType>Github</RepositoryType>
        <PackageReleaseNotes>Version 4.4.0.0 (2026-11-24): Adds support for Net11.0, updates NuGet packages, adds overloads of `WriteTo.PostgreSQL` and `AuditTo.PostgreSQL` that take an `NpgsqlDataSource`, for example to rotate passwords (https://github.com/serilog-contrib/Serilog.Sinks.Postgresql.Alternative/issues/86, https://github.com/serilog-contrib/Serilog.Sinks.Postgresql.Alternative/issues/68), adds `EventTypeColumnWriter` (https://github.com/serilog-contrib/Serilog.Sinks.Postgresql.Alternative/issues/77), adds the option to write the timestamp of `LogEventSerializedColumnWriter` in UTC (https://github.com/serilog-contrib/Serilog.Sinks.Postgresql.Alternative/issues/67), adds the options to leave properties out of the `Properties` and `LogEvent` columns (https://github.com/serilog-contrib/Serilog.Sinks.Postgresql.Alternative/issues/8), fixes `needAutoCreateTable` and `needAutoCreateSchema` failing for users that may not create a table or schema although it already exists (https://github.com/serilog-contrib/Serilog.Sinks.Postgresql.Alternative/issues/93).</PackageReleaseNotes>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <ImplicitUsings>enable</ImplicitUsings>
        <NoWarn>NU1803</NoWarn>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <NuGetAuditMode>all</NuGetAuditMode>
        <NuGetAudit>true</NuGetAudit>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="GitVersion.MsBuild" Version="7.0.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="11.0.0" />
        <PackageReference Include="Npgsql" Version="11.0.0" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="11.0.100" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\Icon.png">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Include="..\..\License.txt">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Include="..\..\README.md">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Include="..\..\Changelog.md">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Include="..\..\HowToUse.md">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
    </ItemGroup>

</Project>
